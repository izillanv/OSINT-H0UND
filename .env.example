# ===========================================================================
# OSINT Hound - fichero de claves de API (EJEMPLO)
# ---------------------------------------------------------------------------
# 1. Copia este fichero a ".env"           ->  cp .env.example .env
# 2. Rellena solo las claves que tengas.    (todas son OPCIONALES)
# 3. El framework funciona sin ninguna: los modulos de pago se desactivan
#    solos y se usan alternativas gratuitas cuando existen.
# ===========================================================================

# HaveIBeenPwned v3 (de pago). Sin ella, las brechas se consultan con
# XposedOrNot, que es gratuito.
HIBP_API_KEY=

# Hunter.io (freemium): descubrimiento/verificacion de correos corporativos.
HUNTER_API_KEY=

# NumVerify (freemium): enriquecimiento telefonico extra. phonenumbers ya
# cubre lo basico sin clave.
NUMVERIFY_API_KEY=
